# Copy to .env.mobile before `npm run build:mobile`.
# Where the Android app finds the Spring Boot API. NOT localhost: on a phone that is the phone itself.
#   Real phone on the same Wi-Fi:  http://<your computer's LAN IP>:8080   (ipconfig -> IPv4 Address)
#   Android Studio emulator:       http://10.0.2.2:8080
#   Production:                    https://api.your-domain.example
VITE_API_BASE_URL=http://192.168.1.20:8080
